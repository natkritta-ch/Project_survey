generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model attendance {
  id        String          @id @default(cuid())
  studentId String
  subjectId String?
  type      attendance_type
  status    String
  timestamp DateTime        @default(now())
  student   user            @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "Attendance_studentId_fkey")
  subject   subject?        @relation(fields: [subjectId], references: [id], map: "Attendance_subjectId_fkey")

  @@index([studentId], map: "Attendance_studentId_fkey")
  @@index([subjectId], map: "Attendance_subjectId_fkey")
  @@index([timestamp])
  @@index([type, timestamp])
}


model schedule {
  id        String    @id @default(cuid())
  subjectId String
  dayOfWeek Int
  startTime String
  endTime   String
  deletedAt DateTime?
  subject   subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade, map: "Schedule_subjectId_fkey")

  @@index([subjectId], map: "Schedule_subjectId_fkey")
  @@index([dayOfWeek, deletedAt])
}

model subject {
  id           String       @id @default(cuid())
  name         String
  code         String
  level        String       @default("-")
  group        String       @default("ก.1,2")
  room         String?
  academicYear String       @default("2569")
  term         String       @default("1")
  credit       Float        @default(3)
  teacherId    String?
  lateThresholdMin Int      @default(15) // เวลาสายของวิชานี้ (นาที)
  deletedAt    DateTime?
  attendance   attendance[]
  schedule     schedule[]
  makeupClasses makeupClass[]
  teacher      user?        @relation(fields: [teacherId], references: [id], map: "Subject_teacherId_fkey")

  @@unique([code, academicYear, term, group, level])
  @@index([teacherId], map: "Subject_teacherId_fkey")
  @@index([deletedAt])
}

model makeupClass {
  id        String    @id @default(cuid())
  subjectId String
  date      DateTime  @db.Date // วันที่สอนชดเชย
  startTime String    // e.g. "09:00"
  endTime   String    // e.g. "11:00"
  remark    String?   // หมายเหตุ เช่น สอนชดเชยคาบวันหยุด
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  subject   subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade, map: "MakeupClass_subjectId_fkey")

  @@index([subjectId], map: "MakeupClass_subjectId_fkey")
  @@index([deletedAt])
  @@map("makeup_class")
}

model termConfig {
  id           String   @id @default(cuid())
  academicYear String
  term         String
  startDate    DateTime
  endDate      DateTime
  isCurrent    Boolean  @default(false)

  @@unique([academicYear, term], map: "TermConfig_academicYear_term_key")
  @@map("termconfig")
}

model user {
  id                 String       @id @default(cuid())
  name               String
  username           String       @unique(map: "User_username_key")
  password           String
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean      @default(false)
  role               user_role
  faceDescriptor     String?      @db.Text
  level              String?
  canEditProfile     Boolean      @default(false)
  nickname           String?
  phone              String?
  address            String?      @db.Text
  bloodType          String?
  gender             String?
  email              String?      @unique(map: "User_email_key")
  nationalId         String?      // รหัสประจำตัวประชาชน
  parentCode         String?      @unique(map: "User_parentCode_key") // รหัสผูกสำหรับผู้ปกครอง
  isTwin             Boolean      @default(false)
  twinNote           String?      @db.Text
  twinVerified       Boolean      @default(false)
  profilePicture     String?      @db.MediumText
  studentId          String?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now())
  attendances        attendance[]
  subjects           subject[]
  student            user?        @relation("userTouser", fields: [studentId], references: [id], map: "User_studentId_fkey")
  students           user[]       @relation("userTouser")

  parentLinks        ParentStudentLink[] @relation("ParentLinks")
  studentLinks       ParentStudentLink[] @relation("StudentLinks")

  primaryAdvisories  ClassroomAdvisor[]  @relation("PrimaryAdvisor")
  coAdvisories       ClassroomAdvisor[]  @relation("CoAdvisor")

  @@index([studentId], map: "User_studentId_fkey")
  @@index([role, deletedAt])
}

model ClassroomAdvisor {
  id               String   @id @default(cuid())
  academicYear     String
  level            String   // ปวช.1, ปวช.2, ปวช.3, ปวส.1, ปวส.2, ปวส.1(ม.6), ปวส.2(ม.6)
  primaryAdvisorId String?
  coAdvisorId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  primaryAdvisor   user?    @relation("PrimaryAdvisor", fields: [primaryAdvisorId], references: [id], onDelete: SetNull)
  coAdvisor        user?    @relation("CoAdvisor", fields: [coAdvisorId], references: [id], onDelete: SetNull)

  @@unique([academicYear, level])
  @@index([primaryAdvisorId])
  @@index([coAdvisorId])
  @@map("classroom_advisor")
}

model ParentStudentLink {
  id          String   @id @default(cuid())
  parentId    String
  studentId   String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      user     @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student     user     @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

enum attendance_type {
  class
  assembly
}

enum user_role {
  HEAD
  TEACHER
  STUDENT
  PARENT
}
